<!DOCTYPE html>
<html>
<head>
  <title>College Placement Management System - Express.js</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <h1>Registered Students</h1>
    <a href="/">Home</a>
    {{#each students}}
    <div class="card">
      <h2>{{name}}</h2>
      <p><strong>ID:</strong> {{id}}</p>
      <p><strong>Course:</strong> {{course}}</p>
      <p><strong>Skills:</strong> {{skills}}</p>
      {{#if available}}
      <p class="available">
        Available for placement
      </p>
      {{else}}
      <p class="unavailable">
        Currently unavailable
      </p>
      {{/if}}
      <a href="/student/{{id}}">View Student</a>
    </div>
    {{/each}}
  </div>
</body>
</html>